{
  "name": "@stellar-agent-registry/sdk",
  "version": "0.1.0",
  "description": "Core TypeScript SDK for Stellar on-chain agent discovery and reputation",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.3.0"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "stellar",
    "soroban",
    "sdk",
    "ai-agents",
    "agent-registry",
    "x402",
    "mpp",
    "web3"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_ORG/stellar-agent-registry"
  }
}
